#!/usr/bin/env bash
# Runs one tool on one target in one mode, under script/watchdog.
#
#   run_one TARGET TOOL MODE JOBS RUN [STRATEGY]
#
#   TARGET    addressable | hashie | lobsters | human-essentials
#   TOOL      saboteur | mutineer
#   MODE      defaults | matched
#   JOBS      worker count (same for both tools)
#   RUN       run number, for the output name
#   STRATEGY  mutineer only: reload | redefine (default: the tool's own)
#
# Environment:
#   BENCH_TARGETS  directory holding the target checkouts and their bundles
#   BENCH_OUT      directory for results (default: bench/vs-mutineer/raw/runs)
#   BENCH_SUBSET   optional file of sources to use instead of sources.txt
#   BENCH_WARM     1 keeps both tools' caches from the previous run
#
# Writes OUT/NAME.json (the tool's own JSON report) and OUT/NAME.{out,err,watchdog}.
set -euo pipefail

target=$1 tool=$2 mode=$3 jobs=$4 run=$5 strategy=${6:-}
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
configs=$here/configs/$target
: "${BENCH_TARGETS:?set BENCH_TARGETS}"
out=${BENCH_OUT:-$here/raw/runs}
mkdir -p "$out"
dir=$BENCH_TARGETS/$target
sources_file=${BENCH_SUBSET:-$configs/sources.txt}
# bash 3.2 (macOS) has no mapfile.
sources=() tests=()
while IFS= read -r line; do [ -n "$line" ] && sources+=("$line"); done < "$sources_file"
while IFS= read -r line; do [ -n "$line" ] && tests+=("$line"); done < "$configs/tests.txt"

name=$target-$tool-$mode-j$jobs${strategy:+-$strategy}-r$run
report=$out/$name.json
settings=$configs/env.sh # target environment: RUBY_CMD, RAILS, limits
# shellcheck source=/dev/null
. "$settings"

case $tool in
  saboteur)
    # SABOTEUR_REF is pinned in PHASE0.md (2b6ec02, from the YAML era), so this
    # config is YAML on purpose. Re-pin to a current ref (and port this file to
    # config/saboteur.rb) before rerunning against a current saboteur.
    config=$out/$name.saboteur.yml
    {
      echo "# generated by run_one; same sources and tests as mutineer"
      [ "${RAILS:-false}" = true ] && echo "rails: true"
      echo "include:"
      printf '  - %s\n' "${sources[@]}"
      echo "rspec_args:"
      printf '  - %s\n' "${tests[@]}"
    } > "$config"
    cmd=(bundle exec saboteur run --config "$config" --jobs "$jobs" --json "$report")
    ;;
  mutineer)
    args=()
    for t in "${tests[@]}"; do args+=(--test "$t"); done
    [ "$mode" = matched ] && args+=(--operators "$(cat "$here/matched-operators-mutineer.txt")")
    if [ "${RAILS:-false}" = true ]; then
      # --daemon, mutineer's only parallel Rails mode, is Minitest-only in
      # 1.6.0 ("rspec is not implemented on the daemon path yet"), so RSpec
      # apps run with --rails alone, which mutineer forces to one worker.
      args+=(--rails)
    fi
    [ -n "$strategy" ] && args+=(--strategy "$strategy")
    cmd=(bundle exec mutineer run "${sources[@]}" "${args[@]}" --jobs "$jobs"
         --cache-dir ".mutineer-bench" --format json --output "$report" ${BENCH_MUTINEER_ARGS:-})
    ;;
  *) echo "unknown tool $tool" >&2; exit 2 ;;
esac

cd "$dir"
# Cold start for both tools unless BENCH_WARM=1: no coverage map, no result
# cache. Each tool's cache lives in its own directory inside the target.
[ "${BENCH_WARM:-0}" = 1 ] || rm -rf .saboteur .mutineer-bench
"$repo/script/watchdog" "$out/$name" --procs "${MAX_PROCS:-80}" --rss-gb "${MAX_RSS_GB:-12}" \
  --minutes "${MAX_MINUTES:-240}" -- "${RUBY_CMD[@]}" "${cmd[@]}"
