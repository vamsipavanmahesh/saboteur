#!/usr/bin/env ruby
# SPDX-License-Identifier: MIT
# frozen_string_literal: true

# Clones a pinned public project from integration/targets.yml and runs
# saboteur against it with that project's own Gemfile plus saboteur.
#
#   script/integration-target NAME [WORKDIR] [--reeval STRATEGY] [--recorder NAME] [--check] [-- extra saboteur args]
#
# --check compares the number of mutants per status with the snapshot in
# integration/targets.yml and fails on any difference.
#
# --recorder is handed to the target's config as SABOTEUR_COVERAGE_RECORDER
# (coverage or trace) and tags the report file, so two recorders can be
# compared (script/integration-recorders). A target's patch (a file under
# integration/patches) is applied to its checkout after the pinned commit is
# checked out, and its env (a map in integration/targets.yml) is passed to
# every command.
#
# The target's checkout is only written to by its own test suite and by
# saboteur's .saboteur/ cache. The combined Gemfile, its lockfile and the
# JSON report live in WORKDIR, outside the checkout.

require "English"
require "fileutils"
require "json"
require "shellwords"
require "tmpdir"
require "yaml"

require_relative "integration_target"

ROOT = File.expand_path("..", __dir__)

args = ARGV.dup
extra = (index = args.index("--")) ? args.slice!(index..)[1..] : []
check = !args.delete("--check").nil?
strategy = (index = args.index("--reeval")) ? args.slice!(index, 2).last : "nesting"
recorder = (index = args.index("--recorder")) ? args.slice!(index, 2).last : nil
RECORDERS = %w[coverage trace].freeze
abort "unknown recorder #{recorder.inspect}; known: #{RECORDERS.join(',')}" if recorder && !RECORDERS.include?(recorder)
name, workdir = args
targets = YAML.safe_load_file(File.join(ROOT, "integration", "targets.yml"))
target = targets.fetch(name) { abort "unknown target #{name.inspect}; known: #{targets.keys.join(', ')}" }

workdir = File.expand_path(workdir || Dir.mktmpdir("saboteur-target-"))
checkout = File.join(workdir, name)
bundle_dir = File.join(workdir, "#{name}-bundle")

def sh(*cmd, **)
  warn "+ #{cmd.shelljoin}"
  system(*cmd, **) or abort "command failed: #{cmd.shelljoin}"
end

unless File.directory?(File.join(checkout, ".git"))
  FileUtils.mkdir_p(checkout)
  sh("git", "init", "-q", chdir: checkout)
  sh("git", "fetch", "-q", "--depth", "1", target.fetch("repo"), target.fetch("commit"), chdir: checkout)
end
# --force and clean (ignored files too) drop the patch of an earlier run before it is applied again.
sh("git", "checkout", "-q", "--force", "--detach", target.fetch("commit"), chdir: checkout)
sh("git", "clean", "-fdxq", chdir: checkout)
sh("git", "apply", File.join(ROOT, target["patch"]), chdir: checkout) if target["patch"]

FileUtils.mkdir_p(bundle_dir)
gemfile = File.join(bundle_dir, "Gemfile")
File.write(gemfile, <<~RUBY)
  eval_gemfile #{File.join(checkout, 'Gemfile').inspect}
  gem "saboteur", path: #{ROOT.inspect}
RUBY

env = { "BUNDLE_GEMFILE" => gemfile, "BUNDLE_WITHOUT" => target.fetch("bundle_without", "") }
env.merge!(target.fetch("env", {}).transform_values(&:to_s))
env["SABOTEUR_COVERAGE_RECORDER"] = recorder if recorder
sh(env, "bundle", "install", "--quiet")
config = File.join(ROOT, target.fetch("config"))
report = File.join(workdir, "#{[name, strategy, recorder].compact.join('-')}.json")
# A report from an earlier run must never speak for this one.
FileUtils.rm_f(report)
system(env, "bundle", "exec", "saboteur", "run", "--config", config, "--reeval", strategy, "--json", report,
       *extra, chdir: checkout)
code = $CHILD_STATUS.exitstatus

# A target whose own tests error on most mutants (the killing test also
# fails with the method unchanged) trips the majority-error exit on every
# run. Such a target names its error profile as allow_error_fraction in
# targets.yml; exit 3 is accepted only when this run's own report shows
# the majority-error outcome within the allowance.
unless [0, 1].include?(code) ||
       IntegrationTarget.accept_error_majority?(code, target.dig("allow_error_fraction", strategy), report)
  abort "saboteur failed with exit code #{code}"
end
if code == 3
  actual = IntegrationTarget.counts(report)
  executed = actual.values_at("killed", "survived", "timeout", "error").sum
  warn "#{name} (#{strategy}): #{actual['error']} of #{executed} mutants errored, " \
       "within the allowed #{target.dig('allow_error_fraction', strategy)}"
end
exit 0 unless check

# Survivors are expected in someone else's project. What must not change
# silently is how many mutants land in each status at the pinned commit.
actual = IntegrationTarget.counts(report)
expected = target.fetch("expect").fetch(strategy)
# Some targets' own tests depend on the machine (a terminal, a command on
# PATH), so a few counts differ by platform; those live under expect_on.
platform = RUBY_PLATFORM.include?("linux") ? "linux" : "macos"
expected = expected.merge(target.dig("expect_on", platform, strategy) || {})
# A key is one status, or a sum of statuses ("killed+error") for mutants
# that move between those statuses from run to run while their total holds.
count = ->(key) { key.split("+").sum { |status| actual[status] } }
diff = expected.reject { |key, value| count.call(key) == value }
if diff.any?
  abort "#{name} (#{strategy}): counts changed: " +
        diff.map { |key, value| "#{key} expected #{value}, got #{count.call(key)}" }.join("; ")
end
puts "#{name} (#{strategy}): counts match #{expected}"
