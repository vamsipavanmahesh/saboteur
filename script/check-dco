#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Fails if any non-merge commit in BASE..HEAD lacks a Signed-off-by trailer
# matching its author (git interpret-trailers, so a sign-off embedded in the
# subject or mid-body does not count).
set -euo pipefail

base="$1"
head="$2"
status=0

for sha in $(git rev-list --no-merges "$base..$head"); do
  author="$(git log -1 --format='%an <%ae>' "$sha")"
  if ! git log -1 --format='%B' "$sha" | git interpret-trailers --parse | grep -qxF "Signed-off-by: $author"; then
    echo "::error::$sha ($(git log -1 --format=%s "$sha")) lacks a 'Signed-off-by: $author' trailer"
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "Fix with: git rebase --signoff $base"
fi
exit "$status"
