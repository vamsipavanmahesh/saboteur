#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Fails if any non-merge commit in BASE..HEAD lacks a Signed-off-by line
# matching its author.
set -euo pipefail

base="$1"
head="$2"
status=0

for sha in $(git rev-list --no-merges "$base..$head"); do
  author="$(git log -1 --format='%an <%ae>' "$sha")"
  if ! git log -1 --format='%B' "$sha" | grep -qF "Signed-off-by: $author"; then
    echo "::error::$sha ($(git log -1 --format=%s "$sha")) lacks 'Signed-off-by: $author'"
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "Fix with: git rebase --signoff $base"
fi
exit "$status"
