# Chatwoot .env used for the field run (RAILS_ENV=test). Generate values locally:
# SECRET_KEY_BASE: `openssl rand -hex 64`; the three ACTIVE_RECORD_ENCRYPTION_* via `rails db:encryption:init`
RAILS_ENV=test
REDIS_URL=redis://localhost:6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot_test
SECRET_KEY_BASE=<generate: openssl rand -hex 64>
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=<generate: rails db:encryption:init>
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=<generate: rails db:encryption:init>
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=<generate: rails db:encryption:init>
FRONTEND_URL=http://localhost:3000
