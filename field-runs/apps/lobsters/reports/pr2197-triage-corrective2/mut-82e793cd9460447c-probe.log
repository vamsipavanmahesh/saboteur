checkbox\" value=\"aria {describedby: &quot;notificationmodhint&quot;}\" checked=\"checked\" name=\"user[email_messages]\" id=\"edit_user_user_email_messages\" />\n          <span class=\"hint\" id=\"notificationmodhint\">\n            Notifications from Moderators are mandatory\n          </span>\n        </span>\n        <label class=\"for_checkbox\" for=\"edit_user_user_pushover_messages\">Receive Pushover Alert</label>\n        <span>\n          <input name=\"user[pushover_messages]\" type=\"hidden\" value=\"0\" autocomplete=\"off\" /><input aria-describedby=\"pushoverhintmessage\" type=\"checkbox\" value=\"1\" name=\"user[pushover_messages]\" id=\"edit_user_user_pushover_messages\" />\n          <span class=\"hint\" id=\"pushoverhintmessage\">\n            Requires Pushover subscription below\n          </span>\n        </span>\n      </div>\n    </section>\n\n    <section>\n      <h2>Submitted Story Comment Settings</h2>\n\n      <div class=\"labelled_grid\">\n        <label class=\"for_checkbox\" for=\"edit_user_user_show_submitted_story_threads\">Show in <a href=\"/threads\">Your Threads</a></label>\n        <span><input name=\"user[show_submitted_story_threads]\" type=\"hidden\" value=\"0\" autocomplete=\"off\" /><input type=\"checkbox\" value=\"1\" name=\"user[show_submitted_story_threads]\" id=\"edit_user_user_show_submitted_story_threads\" /></span>\n      </div>\n    </section>\n\n    <section>\n      <h2>Mailing List Settings</h2>\n\n      <p>\n      When enabled, you will receive all newly submitted stories and comments to\n      your e-mail address entered above, except the stories and comments filtered\n      by your <a href=\"/filters\">tag filters</a>.\n      All e-mail messages will appear to be sent to your private list address\n      shown below which you can filter on, and e-mails you send to that address\n      will be posted under your account on this website.  You should keep your\n      unique list address private to prevent others from posting comments as you.\n      </p>\n\n      <div class=\"labelled_grid\">\n        <label for=\"edit_user_user_mailing_list_mode\">Receive List E-mails</label>\n        <select required=\"required\" name=\"user[mailing_list_mode]\" id=\"edit_user_user_mailing_list_mode\"><option value=\"\" label=\" \"></option>\n<option selected=\"selected\" value=\"0\">No e-mails</option>\n<option value=\"1\">All stories and comments</option>\n<option value=\"2\">Only stories</option></select>\n        <label>List Address</label>\n        <span>\n          <tt>lobsters-HyxmboSZD8@lobste.rs</tt>\n        </span>\n      </div>\n    </section>\n\n    <section>\n      <h2>Miscellaneous Settings</h2>\n        <fieldset class=\"radio-group-container grid-fieldset\">\n          <legend>Color Scheme</legend>\n          <div class=\"radio-group grid-fieldset\">\n            <label><input aria-describedby=\"color-scheme-details\" type=\"radio\" value=\"system\" checked=\"checked\" name=\"user[prefers_color_scheme]\" id=\"edit_user_user_prefers_color_scheme_system\" /> System (<a href=\"https://lobste.rs/s/eg1n75/dark_mode\" id=\"color-scheme-details\">details</a>)</label>\n            <label><input type=\"radio\" value=\"light\" name=\"user[prefers_color_scheme]\" id=\"edit_user_user_prefers_color_scheme_light\" /> Light</label>\n            <label><input type=\"radio\" value=\"dark\" name=\"user[prefers_color_scheme]\" id=\"edit_user_user_prefers_color_scheme_dark\" /> Dark</label>\n          </div>\n        </fieldset>\n\n        <fieldset class=\"radio-group-container grid-fieldset\">\n          <legend>Contrast</legend>\n          <div class=\"radio-group\">\n            <label><input type=\"radio\" value=\"system\" checked=\"checked\" name=\"user[prefers_contrast]\" id=\"edit_user_user_prefers_contrast_system\" /> System</label>\n            <label><input type=\"radio\" value=\"normal\" name=\"user[prefers_contrast]\" id=\"edit_user_user_prefers_contrast_normal\" /> Normal</label>\n            <label><input type=\"radio\" value=\"high\" name=\"user[prefers_contrast]\" id=\"edit_user_user_prefers_contrast_high\" /> High</label>\n          </div>\n        </fieldset>\n\n      <div class=\"labelled_grid\">\n        <label class=\"for_checkbox\" for=\"edit_user_user_show_story_previews\">Show Story Previews</label>\n        <span><input name=\"user[show_story_previews]\" type=\"hidden\" value=\"0\" autocomplete=\"off\" /><input type=\"checkbox\" value=\"1\" name=\"user[show_story_previews]\" id=\"edit_user_user_show_story_previews\" /></span>\n\n        <label class=\"for_checkbox\" for=\"edit_user_user_show_avatars\">Show User Avatars</label>\n        <span><input name=\"user[show_avatars]\" type=\"hidden\" value=\"0\" autocomplete=\"off\" /><input type=\"checkbox\" value=\"1\" checked=\"checked\" name=\"user[show_avatars]\" id=\"edit_user_user_show_avatars\" /></span>\n      </div>\n\n      <br><br>\n      <input type=\"submit\" name=\"commit\" value=\"Save Account Settings\" data-disable-with=\"Save Account Settings\">\n    </section>\n</form></section>\n\n<section>\n  <h2 name=\"external\">External Accounts</h2>\n\n  <div class=\"labelled_grid\">\n    <label for=\"gravatar\"><a href=\"https://gravatar.com/\">Gravatar</a></label>\n    <span>\n      Your avatar will be cached from the Gravatar icon for your e-mail address above.\n      <form class=\"link_post\" action=\"/avatars/expire\" accept-charset=\"UTF-8\" method=\"post\">\n  <input type=\"submit\" name=\"commit\" value=\"Expire cache\" class=\"link_post \" data-disable-with=\"Expire cache\">\n</form>\n    </span>\n    <label for=\"avatar_source\">Avatar</label>\n    <form id=\"update_avatar_source\" action=\"/settings/update_avatar_source\" accept-charset=\"UTF-8\" method=\"post\">\n      <span class=\"hint\">\n        Lobsters fetches and serves avatars directly for visitor privacy\n      </span>\n\n      <select name=\"user[avatar_source]\" id=\"update_avatar_source_user_avatar_source\"><option value=\"0\">Gravatar</option>\n<option value=\"1\">GitHub</option></select>\n\n      <input type=\"submit\" name=\"commit\" value=\"Save Avatar Settings\" data-disable-with=\"Save Avatar Settings\">\n</form>  </div>\n</section>\n\n<section>\n  <h2 name=\"invite\">Invite a New User</h2>\n\n    <p>\nInvitations are unlimited, but persons you invite will be associated with your account\nin the <a href=\"/users\">user tree</a>\nand you may be responsible for them if they cause problems.\nPlease use your discretion when inviting persons you don't personally know.\n</p>\n\n<p>\nNote to trans users:\nUser profiles list the user who invited them.\nIf you want to avoid connecting your old and new usernames, ask <a href=\"/moderators\">a moderator</a> to send you an invite.\n</p>\n\n<form action=\"/invitations\" accept-charset=\"UTF-8\" method=\"post\">\n\n  <div class=\"labelled_grid\">\n    <label for=\"email\">E-mail Address</label>\n    <input autocomplete=\"off\" inputmode=\"email\" required=\"required\" autocapitalize=\"off\" type=\"email\" name=\"email\" id=\"email\" />\n\n    <label for=\"memo\">Memo to User</label>\n    <input type=\"text\" name=\"memo\" id=\"memo\" />\n  </div>\n\n  <input type=\"submit\" name=\"commit\" value=\"Send Invitation\" data-disable-with=\"Send Invitation\">\n</form>\n\n</section>\n\n<section>\n  <form id=\"deactivate_user\" action=\"/settings/deactivate\" accept-charset=\"UTF-8\" method=\"post\">\n    <h2>Deactivate Account</h2>\n    <p>\n    To deactivate your account, verify your current password below.\n    </p>\n    <ul>\n      <li>Your profile will show that you deactivated your account.</li>\n      <li>You will not be able to log in, but you can reset your password if you want to reactivate your account.</li>\n      <li>Your username will remain reserved and will not be available for any other account.</li>\n      <li>Your private messages will be deleted (recipients will keep their copies of messages).</li>\n      <li>Your submitted stories will not be deleted.</li>\n      <li>\n        Your comments with negative scores will be deleted, and you can check \"disown comments\"\n        below if you want all of your stories and comments to change to list\n        <a href=\"/~inactive-user\">inactive-user</a> instead of your username.\n      </li>\n    </ul>\n\n    <div class=\"labelled_grid\">\n      <label for=\"deactivate_user_user_password\">Verify Password</label>\n      <input required=\"required\" autocomplete=\"off\" type=\"password\" name=\"user[password]\" id=\"deactivate_user_user_password\" />\n      <label class=\"for_checkbox\" for=\"deactivate_user_user_i_am_sure\">I am sure</label>\n      <span><input name=\"user[i_am_sure]\" type=\"hidden\" value=\"0\" autocomplete=\"off\" /><input required=\"required\" type=\"checkbox\" value=\"1\" name=\"user[i_am_sure]\" id=\"deactivate_user_user_i_am_sure\" /></span>\n      <label class=\"for_checkbox\" for=\"deactivate_user_user_disown\">Disown stories/comments</label>\n      <span><input name=\"user[disown]\" type=\"hidden\" value=\"0\" autocomplete=\"off\" /><input aria-describedby=\"disownhint\" type=\"checkbox\" value=\"1\" name=\"user[disown]\" id=\"deactivate_user_user_disown\" /> <span class=\"hint\" id=\"disownhint\">(optional)</span></span>\n    </div>\n\n    <input type=\"submit\" name=\"commit\" value=\"Yes, Deactivate My Account\" class=\"deletion\" data-disable-with=\"Yes, Deactivate My Account\">\n</form></section>\n\n  </div>\n\n  <footer>\n    <span id=\"office-hours-live\">\n    </span>\n\n    <nav>\n      <a href=\"/about\">About</a>\n      <a href=\"/tags\">Tags</a>\n      <a href=\"/filters\">Filter</a>\n      <a href=\"/moderations\">Moderation Log</a>\n    </nav>\n  </footer>\n\n  <span id=\"iab-pcm-sdk\"></span><span id=\"iab-autofill-sdk\"></span>\n</body>\n</html>\n"
