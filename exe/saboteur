#!/usr/bin/env ruby
# SPDX-License-Identifier: MIT
# frozen_string_literal: true

# Last resort above the CLI itself: a crash while coverage is set up, while
# the CLI is being required, or while the command line is being built or
# parsed escapes the CLI's rescue, so the executable reports it the same
# way. StandardError only - Interrupt and SystemExit keep their own meaning.
begin
  # Line coverage must be set up before any target code loads, so it happens
  # first. For `run` it also counts from here: what executes while the app and
  # spec files load is how ran-at-load mutants are told apart from uncovered
  # ones. The engine suspends counting right after boot and reads the
  # counters as the map's load lines (a forked child would not inherit them).
  require "coverage"
  Coverage.setup(lines: true, methods: true, branches: true) if Coverage.state == :idle
  Coverage.resume if ARGV.first == "run" && Coverage.state == :suspended

  require "saboteur/cli"

  exit Saboteur::CLI.new(ARGV).call
rescue StandardError => e
  # Agent mode is visible in the raw arguments, so a constructor failure
  # still answers an agent with JSON - as long as the CLI got far enough
  # to define the reporter.
  agent = defined?(Saboteur::CLI) && Saboteur::CLI.respond_to?(:agent_requested?) &&
          Saboteur::CLI.agent_requested?(ARGV)
  if defined?(Saboteur::CrashReport)
    exit Saboteur::CrashReport.call(e, verbose: ARGV.include?("--verbose"), agent: agent,
                                       err: $stderr, out: $stdout,
                                       log_path: File.join(Dir.pwd, ".saboteur", "internal-error.log"))
  end

  # Even the reporter failed to load: keep the promise that matters most.
  warn "saboteur: internal error (#{e.class}: #{e.message}) - please report it: " \
       "https://github.com/vamsipavanmahesh/saboteur/issues"
  exit 3
end
