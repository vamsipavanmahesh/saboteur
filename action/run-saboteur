#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Runs saboteur in diff mode for the saboteur GitHub Action (see action.yml).
#
# Input comes from environment variables, never from shell text:
#   SABOTEUR_EVENT_NAME         GitHub event name; the action runs on "pull_request", and on
#                             "workflow_dispatch" for saboteur's own manual PR CI
#   SABOTEUR_BASE_SHA           exact base commit: from the pull_request event, or from the
#                             workflow's base_sha dispatch input
#   SABOTEUR_EXPECTED_HEAD_SHA  checkout commit from the same GitHub event
#   SABOTEUR_COMMAND            how to start saboteur, for example "bundle exec saboteur"
#   SABOTEUR_ARGUMENTS          extra saboteur arguments, split on whitespace (no shell quoting)
#   SABOTEUR_FAIL_ON_SURVIVORS  "true" or "false"; "true" also fails on an incomplete run
#   SABOTEUR_MAX_TIMEOUTS       optional --max-timeouts limit: a count ("3") or a percentage ("5%")
#   SABOTEUR_MAX_ERRORS         optional --max-errors limit, same shape
#   SABOTEUR_REPORT_PATH        where saboteur writes its JSON report
#   SABOTEUR_CACHE              "true" or "false"; "false" also passes --no-cache to saboteur
# Exit codes of saboteur: 0 clean, 1 survivors, 2 usage error, 3 tool error.
# This script exits 2 for input it refuses, and 3 when saboteur's result cannot be trusted.
set -uo pipefail

event_name="${SABOTEUR_EVENT_NAME:-}"
base_sha="${SABOTEUR_BASE_SHA:-}"
expected_head_sha="${SABOTEUR_EXPECTED_HEAD_SHA:-}"
pull_ref="${GITHUB_REF:-}"
command_line="${SABOTEUR_COMMAND:-bundle exec saboteur}"
extra_arguments="${SABOTEUR_ARGUMENTS:-}"
fail_on_survivors="${SABOTEUR_FAIL_ON_SURVIVORS:-false}"
max_timeouts="${SABOTEUR_MAX_TIMEOUTS:-}"
max_errors="${SABOTEUR_MAX_ERRORS:-}"
max_duration="${SABOTEUR_MAX_DURATION:-}"
report_path="${SABOTEUR_REPORT_PATH:-.saboteur/report.json}"
use_cache="${SABOTEUR_CACHE:-true}"
github_output="${GITHUB_OUTPUT:-/dev/null}"
step_summary="${GITHUB_STEP_SUMMARY:-/dev/null}"

write_output() { echo "$1=$2" >>"$github_output"; }

# A workflow command cannot hold %, CR or LF; a property value cannot hold :
# or , on top of that. The report carries source text, which can be anything.
escape_data() {
  local text="$1"
  text="${text//%/%25}"
  text="${text//$'\r'/%0D}"
  text="${text//$'\n'/%0A}"
  printf '%s' "$text"
}

escape_property() {
  local text
  text="$(escape_data "$1")"
  text="${text//:/%3A}"
  text="${text//,/%2C}"
  printf '%s' "$text"
}

# Inline code in the summary. The span is one backtick wider than the
# longest run of backticks in the text, so no source text can close it;
# a text holding backticks is padded, which CommonMark strips again.
code_span() {
  local text="$1"
  local longest ticks
  if [ -z "$text" ]; then
    printf '(empty)'
    return
  fi
  longest="$(printf '%s' "$text" | awk 'BEGIN { l = 0 } { while (match($0, /`+/)) { if (RLENGTH > l) l = RLENGTH; $0 = substr($0, RSTART + RLENGTH) } } END { print l }')"
  ticks="$(printf '%*s' "$((longest + 1))" '' | tr ' ' '`')"
  if [ "$longest" -gt 0 ]; then
    printf '%s %s %s' "$ticks" "$text" "$ticks"
  else
    printf '%s%s%s' "$ticks" "$text" "$ticks"
  fi
}

# Source text can span lines; the summary list shows one line per survivor.
one_line() {
  local text="$1"
  text="${text//$'\r\n'/⏎}"
  text="${text//$'\n'/⏎}"
  text="${text//$'\r'/⏎}"
  printf '%s' "$text"
}

# Base64 field transport. Capturing the decoded text would strip trailing
# newlines out of the source text, so the value lands in a named variable
# and a sentinel keeps the newlines in place.
decode_field() {
  local decoded
  decoded="$(printf '%s' "$1" | base64 -d && printf 'x')"
  printf -v "$2" '%s' "${decoded%x}"
}


stop_with_error() {
  echo "::error::$1"
  write_output ran false
  exit "${2:-2}"
}

if [ "$event_name" != "pull_request" ] && [ "$event_name" != "workflow_dispatch" ]; then
  echo "::notice::saboteur: this action only runs on pull_request and workflow_dispatch events (this one is '${event_name:-unknown}'). Nothing was mutated."
  write_output ran false
  exit 0
fi

if [ -z "$base_sha" ]; then
  stop_with_error "saboteur: the event did not provide its base SHA. On pull_request this is github.event.pull_request.base.sha; on workflow_dispatch it is the workflow's base_sha input. No mutation run was started."
fi

case "$fail_on_survivors" in
  true | false) ;;
  *) stop_with_error "saboteur: fail-on-survivors must be exactly \"true\" or \"false\", not \"$fail_on_survivors\"." ;;
esac

case "$use_cache" in
  true | false) ;;
  *) stop_with_error "saboteur: cache must be exactly \"true\" or \"false\", not \"$use_cache\"." ;;
esac

# A gate limit is a count or a percentage of at most 100, as saboteur reads it.
valid_gate_limit() {
  [[ "$1" =~ ^[0-9]+%?$ ]] || return 1
  [[ "$1" != *% ]] || [ "$((10#${1%\%}))" -le 100 ]
}

for gate_input in max-timeouts:"$max_timeouts" max-errors:"$max_errors"; do
  if [ -n "${gate_input#*:}" ] && ! valid_gate_limit "${gate_input#*:}"; then
    stop_with_error "saboteur: ${gate_input%%:*} must be a count (3) or a percentage of at most 100 (5%), not \"${gate_input#*:}\"."
  fi
done

if ! [[ "$base_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
  stop_with_error "saboteur: the event did not provide a valid 40-character base SHA. Do not override the base commit."
fi

# The merge-ref shape is a pull_request property; a workflow_dispatch run
# checks out the exact head SHA instead, with full history, so there is no
# merge ref to validate or deepen.
if [ "$event_name" = "pull_request" ] && ! [[ "$pull_ref" =~ ^refs/pull/[0-9]+/merge$ ]]; then
  stop_with_error "saboteur: cannot deepen the pull request checkout safely. Keep actions/checkout on the default pull_request merge ref (refs/pull/<number>/merge), then rerun."
fi

if ! [[ "$expected_head_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
  stop_with_error "saboteur: the pull_request event did not provide a valid checkout SHA. Pass github.sha from the same event."
fi

checked_out_sha="$(git rev-parse --verify --quiet HEAD^{commit} 2>/dev/null || true)"
if [ "$checked_out_sha" != "$expected_head_sha" ]; then
  stop_with_error "saboteur: HEAD ($checked_out_sha) does not match the pull_request event checkout SHA. Check out github.sha for this event before running the action."
fi

if ! [[ "$report_path" =~ ^[A-Za-z0-9._/][A-Za-z0-9._/-]*$ ]]; then
  stop_with_error "saboteur: report-path may only contain letters, digits, dot, underscore, slash and dash, and may not start with a dash."
fi

if ! command -v jq >/dev/null 2>&1; then
  stop_with_error "saboteur: the action needs jq to read the report, and jq was not found on this runner." 3
fi

read -r -a command_words <<<"$command_line"
read -r -a argument_words <<<"$extra_arguments"

# The action owns --since and --json. saboteur accepts unambiguous prefixes
# of long options, so a word such as --js would also reach them.
for word in ${argument_words[@]+"${argument_words[@]}"}; do
  if [ "$word" = "--" ]; then
    stop_with_error "saboteur: 'arguments' may not contain a bare --, because the action's --since and --json come after it."
  fi
  option_name="${word%%=*}"
  if [[ "$option_name" == --* ]] && { [[ "--since" == "$option_name"* ]] || [[ "--json" == "$option_name"* ]]; }; then
    stop_with_error "saboteur: 'arguments' may not contain $option_name. The action sets --since from the exact base SHA and --json from report-path."
  fi
done

# Fetch the immutable base commit if it is not already present. Then deepen
# only this PR's merge ref, in bounded increments, until Git proves a merge
# base. Never substitute a branch tip or widen the mutation scope.
if ! git cat-file -e "$base_sha^{commit}" 2>/dev/null; then
  if ! git fetch --no-tags --depth=1 origin "$base_sha"; then
    stop_with_error "saboteur: could not fetch the pull request's exact base SHA. Check that it is available from origin and that the workflow can fetch it."
  fi
fi

if ! git cat-file -e "$base_sha^{commit}" 2>/dev/null; then
  stop_with_error "saboteur: the exact pull request base SHA is not a commit after fetch. Check the event payload and checkout."
fi

merge_base="$(git merge-base "$base_sha" HEAD 2>/dev/null || true)"
attempt=0
while [ -z "$merge_base" ]; do
  if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" != "true" ]; then
    stop_with_error "saboteur: no merge base exists between the exact pull request base SHA and HEAD. Refusing to widen the diff; verify the checkout uses this pull request's history."
  fi
  if [ "$attempt" -ge 20 ]; then
    stop_with_error "saboteur: no merge base found after fetching 2,000 pull-request commits. Increase actions/checkout fetch-depth or fetch more history; refusing to widen the diff."
  fi
  if ! git fetch --no-tags --deepen=100 origin "$pull_ref"; then
    stop_with_error "saboteur: could not deepen pull request history while finding the merge base. Set actions/checkout fetch-depth to 0 or ensure the pull-request merge ref is fetchable; no mutation run was started."
  fi
  attempt=$((attempt + 1))
  # Re-evaluate immediately after each successful fetch, including the last
  # allowed increment, before deciding the bounded search was exhausted.
  merge_base="$(git merge-base "$base_sha" HEAD 2>/dev/null || true)"
done

# A report left by an earlier run (for example a restored cache) must never
# stand in for this run's report.
if ! rm -f -- "$report_path" || [ -e "$report_path" ]; then
  stop_with_error "saboteur: could not remove the old report at $report_path, so this run's result could not be told apart from it." 3
fi

cache_arguments=()
[ "$use_cache" = "false" ] && cache_arguments=(--no-cache)

# The gate inputs come after "arguments", so they win over the same flag there.
gate_arguments=()
[ -n "$max_timeouts" ] && gate_arguments+=(--max-timeouts "$max_timeouts")
[ -n "$max_errors" ] && gate_arguments+=(--max-errors "$max_errors")
# The wall-time budget is a gate input too, so a stray --max-duration in
# "arguments" cannot widen it (#1210).
[ -n "$max_duration" ] && gate_arguments+=(--max-duration "$max_duration")

log_file="$(mktemp)"
"${command_words[@]}" run ${cache_arguments[@]+"${cache_arguments[@]}"} ${argument_words[@]+"${argument_words[@]}"} ${gate_arguments[@]+"${gate_arguments[@]}"} --since "$base_sha" --json "$report_path" 2>&1 | tee "$log_file"
saboteur_status="${PIPESTATUS[0]}"

killed=0 timed_out=0 survivors=0 accepted=0 errors=0 uncovered=0 score="n/a" report_valid=false
if [ "$saboteur_status" -le 1 ]; then
  if [ ! -f "$report_path" ]; then
    echo "::error::saboteur exited with $saboteur_status but wrote no report at $report_path, so the result cannot be trusted. The saboteur output above may say why."
  elif ! counts="$(jq -es -r '
        def known: IN("Killed", "Timeout", "Survived", "NoCoverage", "Ignored", "RuntimeError");
        if length != 1 then error("the report must hold exactly one JSON document")
        else .[0] as $report
          | if ($report | type) != "object" or $report.schemaVersion != "2" or ($report.files | type) != "object"
            then error("the report is not a schemaVersion 2 report with a files object")
            else [ $report.files[]
                   | if type == "object" and (.mutants | type) == "array" then .mutants[]
                     else error("a file entry has no mutants array") end
                   | if type == "object" and (.status | type) == "string" and (.status | known)
                     then {status, accepted: ((.statusReason // "" | tostring) | startswith("ignored:"))}
                     else error("unknown mutant status") end ]
                 | [ (map(select(.status == "Killed")) | length),
                     (map(select(.status == "Timeout")) | length),
                     (map(select(.status == "Survived" and (.accepted | not))) | length),
                     (map(select(.status == "Survived" and .accepted)) | length),
                     (map(select(.status == "RuntimeError")) | length),
                     (map(select(.status == "NoCoverage" or .status == "Ignored")) | length) ] | @tsv
            end
        end' "$report_path" 2>&1)"; then
    echo "::error::saboteur wrote a report at $report_path that could not be read ($counts), so the result cannot be trusted. The saboteur output above may say why."
  else
    report_valid=true
    read -r killed timed_out survivors accepted errors uncovered <<<"$counts"
    scored=$((killed + timed_out + survivors + accepted))
    if [ "$scored" -gt 0 ]; then
      score="$(awk -v good=$((killed + timed_out)) -v all="$scored" 'BEGIN { printf "%.1f", good * 100 / all }')"
    fi
  fi
fi

incomplete=false
[ "$errors" -gt 0 ] && incomplete=true

write_output ran true
write_output exit-code "$saboteur_status"
write_output report-valid "$report_valid"
write_output score "$score"
write_output killed "$killed"
write_output timeouts "$timed_out"
write_output survivors "$survivors"
write_output accepted-survivors "$accepted"
write_output errors "$errors"
write_output incomplete "$incomplete"
write_output report-path "$report_path"

# Each surviving mutant becomes a note on the diff, and the same bounded list
# lands in the summary below. Both come from the report's saboteur.findings
# section, which saboteur 0.3.0 and later write; an older report only gets
# the counts and warnings. The gem bounds the list, so the step stays under
# GitHub's limit of 10 annotations of one kind.
run_url=""
if [ -n "${GITHUB_RUN_ID:-}" ]; then
  run_url="${GITHUB_SERVER_URL:-https://github.com}/${GITHUB_REPOSITORY:-unknown}/actions/runs/$GITHUB_RUN_ID"
fi
artifact_name="${SABOTEUR_ARTIFACT_NAME:-saboteur-report}"
artifact_ref="this run's \`$artifact_name\` artifact"
[ -n "$run_url" ] && artifact_ref="this run's [\`$artifact_name\` artifact]($run_url)"

findings_file="$(mktemp)"
accepted_file="$(mktemp)"
findings_count=0
findings_truncated=0
accepted_count=0
accepted_truncated=0
if [ "$report_valid" = "true" ]; then
  # Findings are only consumed when every field carries its schema type;
  # anything else is rejected in jq and diagnosed, never coerced. The
  # digest charset check is what keeps a tampered report from injecting a
  # workflow command through the annotation.
  findings_filter='
    def valid_survivor:
      type == "object"
      and (.path | type == "string" and length > 0 and (startswith("/") | not) and (contains("..") | not))
      and (.line | type == "number" and floor == . and . >= 1)
      and (.endLine | type == "number" and floor == .)
      and (.endLine >= .line)
      and (.operator | type == "string") and (.subject | type == "string")
      and (.original | type == "string") and (.replacement | type == "string")
      and (.digest | type == "string" and test("^[A-Za-z0-9_-]+$"));
    def valid_accepted:
      type == "object"
      and (.path | type == "string" and length > 0 and (startswith("/") | not) and (contains("..") | not))
      and (.line | type == "number" and floor == . and . >= 1)
      and (.operator | type == "string") and (.subject | type == "string")
      and (.reason | type == "string")
      and (.digest | type == "string" and test("^[A-Za-z0-9_-]+$"));
    .saboteur.findings'
  # The findings section carries the notes. A report without one (an older
  # saboteur) is a supported fallback; a present section that cannot be read
  # is diagnosed instead of silently treated as "no findings".
  findings_gate="$findings_filter
    | type == \"object\" and .version == 1 and (.survivors | type == \"array\")
      and (.survivorsTruncated | type == \"number\" and floor == . and . >= 0)
      and (.accepted | type == \"array\")
      and (.acceptedTruncated | type == \"number\" and floor == . and . >= 0)"
  if jq -e '.saboteur.findings != null' "$report_path" >/dev/null 2>&1 && ! jq -e "$findings_gate" "$report_path" >/dev/null 2>&1; then
    echo "::warning::saboteur: the report's findings section is not in the version 1 format this action reads, so no annotations were written. Align the action and saboteur versions. The counts above still stand."
  fi
  if jq -e "$findings_gate" "$report_path" >/dev/null 2>&1; then
    # The action enforces the annotation bound itself instead of trusting
    # the report: GitHub shows at most 10 annotations of one kind per step.
    # The counters describe what is actually emitted: valid shown findings,
    # findings dropped for failing the schema, and what the bound left out.
    read -r findings_count findings_skipped findings_truncated             accepted_count accepted_skipped accepted_truncated <<<"$(jq -r "$findings_filter
      | [ ([.survivors[:10][] | select(valid_survivor)] | length),
          ((.survivors[:10] | length) - ([.survivors[:10][] | select(valid_survivor)] | length)),
          ((.survivors | length) - (.survivors[:10] | length) + .survivorsTruncated),
          ([.accepted[:10][] | select(valid_accepted)] | length),
          ((.accepted[:10] | length) - ([.accepted[:10][] | select(valid_accepted)] | length)),
          ((.accepted | length) - (.accepted[:10] | length) + .acceptedTruncated) ]
      | @tsv" "$report_path")"
    if [ "$findings_skipped" -gt 0 ] || [ "$accepted_skipped" -gt 0 ]; then
      echo "::warning::saboteur: skipped $((findings_skipped + accepted_skipped)) findings whose fields did not match the findings schema; they are not annotated or listed."
    fi
    # Every field is base64 on its own line: tab separation would collapse
    # an empty field (a pure insertion has no original text) and shift the
    # rest. jq runs to a file first, so a broken finding stream is diagnosed
    # instead of being consumed partway.
    findings_lines="$(mktemp)"
    if ! jq -r "$findings_filter | .survivors[:10][] | select(valid_survivor)
        | [.path, (.line | tostring), (.endLine | tostring), .operator, .subject,
           .original, .replacement, .digest][] | @base64" "$report_path" >"$findings_lines"; then
      echo "::warning::saboteur: the findings could not be read from the report, so no annotations were written."
      : >"$findings_lines"
    fi
    while IFS= read -r path; do
      IFS= read -r line
      IFS= read -r end_line
      IFS= read -r operator
      IFS= read -r subject
      IFS= read -r original
      IFS= read -r replacement
      IFS= read -r digest || break
      decode_field "$path" path
      decode_field "$line" line
      decode_field "$end_line" end_line
      decode_field "$operator" operator
      decode_field "$subject" subject
      decode_field "$original" original
      decode_field "$replacement" replacement
      decode_field "$digest" digest
      echo "::warning file=$(escape_property "$path"),line=${line},endLine=${end_line},title=$(escape_property "Mutant survived: $operator")::$(escape_data "$subject"): $(escape_data "$original") became $(escape_data "$replacement") ($digest). Add a test that fails for this mutant, or accept it in config/saboteur_ignore.rb with a reason."
      printf -- '- %s:%s %s: %s became %s in %s (%s)\n' \
        "$(code_span "$(one_line "$path")")" "$line" \
        "$(code_span "$(one_line "$operator")")" \
        "$(code_span "$(one_line "$original")")" "$(code_span "$(one_line "$replacement")")" \
        "$(code_span "$(one_line "$subject")")" "$(code_span "$(one_line "$digest")")" >>"$findings_file"
    done < "$findings_lines"
    rm -f "$findings_lines"
    # Accepted survivors get no notes - the team already reviewed them - but
    # the summary lists them apart, with the reason from the ignore list.
    if [ "$accepted_count" -gt 0 ]; then
      accepted_lines="$(mktemp)"
      if ! jq -r "$findings_filter | .accepted[:10][] | select(valid_accepted)
          | [.path, (.line | tostring), .operator, .subject, .reason, .digest][] | @base64"           "$report_path" >"$accepted_lines"; then
        echo "::warning::saboteur: the accepted findings could not be read from the report."
        : >"$accepted_lines"
      fi
      while IFS= read -r path; do
        IFS= read -r line
        IFS= read -r operator
        IFS= read -r subject
        IFS= read -r reason
        IFS= read -r digest || break
        decode_field "$path" path
        decode_field "$line" line
        decode_field "$operator" operator
        decode_field "$subject" subject
        decode_field "$reason" reason
        decode_field "$digest" digest
        printf -- '- %s:%s %s in %s - accepted: %s (%s)\n' \
          "$(code_span "$(one_line "$path")")" "$line" \
          "$(code_span "$(one_line "$operator")")" "$(code_span "$(one_line "$subject")")" \
          "$(code_span "$(one_line "$reason")")" "$(code_span "$(one_line "$digest")")" >>"$accepted_file"
      done < "$accepted_lines"
      rm -f "$accepted_lines"
    fi
  fi
fi


# A code fence one backtick longer than any run of backticks in the log, so
# the log cannot close the fence and inject markdown.
fence="$(awk 'BEGIN { longest = 2 } { while (match($0, /`+/)) { if (RLENGTH > longest) longest = RLENGTH; $0 = substr($0, RSTART + RLENGTH) } } END { s = ""; for (i = 0; i <= longest; i++) s = s "`"; print s }' "$log_file")"
{
  echo "## Mutation testing (diff from merge base of exact PR base $base_sha)"
  echo
  if [ "$report_valid" != "true" ] && [ "$saboteur_status" -le 1 ]; then
    echo "**No trusted result.** saboteur exited with $saboteur_status but its report is missing or unreadable."
  elif [ "$saboteur_status" -gt 1 ]; then
    # The report is only trusted on exit 0 or 1, so the zeroed counters above
    # must not speak here: name what actually stopped the run instead (#1209).
    case "$saboteur_status" in
      2) echo "**saboteur stopped: bad configuration (exit 2).** No mutants were scored; the saboteur output below names the complaint." ;;
      3) echo "**saboteur stopped: the diff holds changes it could not verify (exit 3).** Usually that is changed code no test covers; the saboteur output below lists the unverified subjects." ;;
      4) echo "**saboteur stopped early: the --max-duration budget ran out (exit 4).** The partial result is not trusted; widen the budget or shrink the diff." ;;
      5) echo "**saboteur stopped: the baseline suite is red (exit 5).** Fix the failing tests first; the saboteur output below names them." ;;
      70) echo "**saboteur crashed (exit 70, a saboteur bug).** The saboteur output below has the details." ;;
      *) echo "**saboteur stopped with exit code $saboteur_status before producing a trusted result.** Read the saboteur output below." ;;
    esac
  elif [ "$score" = "n/a" ]; then
    # An empty selection is vacuously green (#1186): the report's empty
    # files object identifies it, not the log wording. The saboteur log
    # line supplies only the human reason, rendered in a code span with
    # backticks stripped so repo-controlled names cannot break out into
    # step-summary markdown.
    if [ "$report_valid" = "true" ] && [ "$(jq -r '.files | length' "$report_path")" = "0" ]; then
      nothing_line="$(grep -m1 '^saboteur: .*nothing to test' "$log_file" || true)"
      reason="$(printf '%s' "${nothing_line#saboteur: }" | tr -d '`' | tr '\n' ' ')"
      if [ -n "$reason" ]; then
        echo "**Nothing to test in this diff.** \`$reason\`"
      else
        echo "**Nothing to test in this diff.** The selection held no subjects to mutate."
      fi
    else
      echo "No mutant was scored. $uncovered had no coverage or were ignored, and $errors errored or hit a resource limit."
    fi
  else
    echo "Covered score: **$score %** = (killed + timeout) / (killed + timeout + survived), over $scored scored mutants."
    echo "Killed $killed, timeout $timed_out, survived $survivors, survived and accepted by the ignore list $accepted."
    echo "Not scored: $uncovered with no coverage or ignored, $errors errored or hit a resource limit."
  fi
  [ "$incomplete" = "true" ] && echo && echo "**Incomplete run:** $errors mutants errored or hit a resource limit, so the score covers fewer mutants than were generated."
  if [ "$findings_count" -gt 0 ]; then
    echo "### Surviving mutants, coarse mutants first"
    echo
    cat "$findings_file"
    echo
    if [ "$findings_truncated" -gt 0 ]; then
      echo "Showing the first $findings_count of $((findings_count + findings_truncated)) surviving mutants (coarse mutants first: a surviving coarse mutant hints that no test pins the method's behavior). The rest are in the full JSON report, kept as $artifact_ref."
    else
      echo "The full data behind these notes is kept as $artifact_ref."
    fi
    [ "$findings_skipped" -gt 0 ] && echo "$findings_skipped of the findings were skipped because their fields did not match the findings schema."
    echo
  fi
  if [ "$accepted_count" -gt 0 ]; then
    echo "### Accepted survivors (on the ignore list)"
    echo
    cat "$accepted_file"
    echo
    if [ "$accepted_truncated" -gt 0 ]; then
      echo "And $accepted_truncated more accepted survivors, in the full JSON report kept as $artifact_ref."
      echo
    fi
  fi
  echo
  echo '<details><summary>saboteur output</summary>'
  echo
  echo "$fence"
  cat "$log_file"
  echo "$fence"
  echo '</details>'
} >>"$step_summary"
rm -f "$log_file"

if [ "$saboteur_status" -le 1 ] && [ "$report_valid" != "true" ]; then
  exit 3
fi

case "$saboteur_status" in
  0 | 1)
    if [ "$incomplete" = "true" ]; then
      echo "::warning::saboteur: $errors mutants errored or hit a resource limit. The score does not cover them."
      # With max-errors set, saboteur already judged the errors: exit 0 means they are within the limit.
      [ "$fail_on_survivors" = "true" ] && [ -z "$max_errors" ] && exit 3
    fi
    if [ "$saboteur_status" = "1" ]; then
      if [ "$survivors" -gt 0 ]; then
        echo "::warning::saboteur: $survivors mutants survived. Add a test that fails for each one, or list it in config/saboteur_ignore.rb with a reason."
      else
        echo "::warning::saboteur: exit 1 with no surviving mutants, so a gate failed (--threshold, --max-timeouts or --max-errors). Read the gate line in the output above."
      fi
      [ "$fail_on_survivors" = "true" ] && exit 1
    fi
    exit 0
    ;;
  *)
    echo "::error::saboteur stopped with exit code $saboteur_status (2 means bad configuration, 3 means the change could not be verified, 4 means the --max-duration budget stopped the run early, 5 means the baseline suite is red - fix your tests first, 70 means an internal crash, a saboteur bug). Read the output above."
    exit "$saboteur_status"
    ;;
esac

